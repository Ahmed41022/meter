{
  "name": "meter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An hourly earnings meter — time a session, watch the money accrue, keep an honest ledger per project.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "icons": "python3 scripts/make-icons.py",
    "desktop": "npm run build && node desktop/package.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "vitest": "^4.0.0"
  }
}
